
#api call for register
###
POST http://127.0.0.1:8000/accounts/register/
Content-Type: application/json

{

    "username":"react",
    "email":"react@gmail.com",
    "password":"password@123",
    "phone":"123456789",
    "dob":"2004-10-16"


    
}

#========token========

###
POST http://127.0.0.1:8000/token/
Content-Type: application/json
{
  "username":"django",
  "password"":"
}

#============Expenses============
#api call for listing all expenses

###
GET http://127.0.0.1:8000/expenses/
Accept: application/json

Authorization: Basic django:passowrd@123


#api call for adding expenses
###
POST http://127.0.0.1:8000/expenses/
Content-Type: application/json
Authorization: Basic django:password@123

{
  "title":"fuel",
  "amount":270,
  "category":"fuel"

}








#api call for retrieving expenses
###
GET http://127.0.0.1:8000/127.0.0.1:8000/expenses.authenticate/



###
GET http://127.0.0.1:8000/accounts//summery/
Accept: application/json
Authorization: Basic react:password@123

